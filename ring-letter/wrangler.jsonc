{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ring-letter",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "send_metrics": false,
  // Cloudflare Access only sits in front of the custom domain, so make it the
  // only entry point: no *.workers.dev URL and no per-version preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ring-letter-db",
      // Placeholder for local development. Replace with the real ID from
      // `wrangler d1 create ring-letter-db` before deploying (M3).
      "database_id": "00000000-0000-4000-8000-000000000000",
      "migrations_dir": "drizzle"
    }
  ]
}
