{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ring-letter",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": ["nodejs_compat"],
  "send_metrics": false,
  // Cloudflare Access only sits in front of the custom domain, so make it the
  // only entry point: no *.workers.dev URL and no per-version preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  // Custom domain: wrangler deploy creates the DNS record and certificate.
  // A Cloudflare Access application covers /admin* and /api/admin* here.
  "routes": [{ "pattern": "ringletter.wetrytrysee.cc", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ring-letter-db",
      // Production database (APAC). Local dev (`--local`) uses .wrangler/state.
      "database_id": "ca17f7d6-bd4e-41bd-86e9-6116edd1d8d1",
      "migrations_dir": "drizzle"
    }
  ]
}
